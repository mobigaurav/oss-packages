{
  "name": "@react-native-app-attest/server-verify",
  "version": "0.1.0",
  "description": "Node.js server-side verifier for Apple App Attest attestations and assertions. Pairs with the react-native-app-attest client SDK.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [
    "app-attest",
    "devicecheck",
    "apple",
    "attestation",
    "security"
  ],
  "license": "MIT",
  "dependencies": {
    "cbor": "^9.0.2",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/node-forge": "^1.3.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.ts"
    ]
  }
}
